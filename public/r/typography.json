{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "typography",
  "title": "Typography",
  "description": "다글 타이포 토큰 (Pretendard + text-display-1 ~ text-caption)",
  "dependencies": [
    "pretendard"
  ],
  "files": [],
  "cssVars": {
    "theme": {
      "font-sans": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "text-display-1": "2.5rem",
      "text-display-1--line-height": "3.25rem",
      "text-display-1--font-weight": "700",
      "text-display-1--letter-spacing": "-0.025em",
      "text-heading-1": "2rem",
      "text-heading-1--line-height": "2.75rem",
      "text-heading-1--font-weight": "700",
      "text-heading-1--letter-spacing": "-0.02em",
      "text-heading-2": "1.5rem",
      "text-heading-2--line-height": "2.125rem",
      "text-heading-2--font-weight": "700",
      "text-heading-2--letter-spacing": "-0.02em",
      "text-heading-3": "1.25rem",
      "text-heading-3--line-height": "1.75rem",
      "text-heading-3--font-weight": "600",
      "text-heading-3--letter-spacing": "-0.01em",
      "text-title": "1.125rem",
      "text-title--line-height": "1.625rem",
      "text-title--font-weight": "600",
      "text-title--letter-spacing": "-0.01em",
      "text-body-1": "1rem",
      "text-body-1--line-height": "1.5rem",
      "text-body-1--font-weight": "400",
      "text-body-1--letter-spacing": "0",
      "text-body-2": "0.875rem",
      "text-body-2--line-height": "1.25rem",
      "text-body-2--font-weight": "400",
      "text-body-2--letter-spacing": "0",
      "text-caption": "0.75rem",
      "text-caption--line-height": "1rem",
      "text-caption--font-weight": "400",
      "text-caption--letter-spacing": "0"
    }
  },
  "css": {
    "@import \"pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css\"": {}
  },
  "type": "registry:theme"
}